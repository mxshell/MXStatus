#!/usr/bin/env bash
set -euo pipefail

service_name="MXShellClient"
service_description="MXShell System Status Reporting Service"

get_python_path() {
    if command -v python3 > /dev/null 2>&1; then
        command -v python3
    else
        echo "Python 3 executable not found. Activate the client virtual environment first." >&2
        return 1
    fi
}

# Quote systemd strings and escape specifiers. ExecStart also expands dollar signs.
unit_quote() {
    local value="$1"
    value="${value//\\/\\\\}"
    value="${value//\"/\\\"}"
    value="${value//%/%%}"
    value="${value//$'\n'/\\n}"
    value="${value//$'\r'/\\r}"
    printf '"%s"' "$value"
}

working_directory="$(cd -- "$(dirname -- "$0")" && pwd -P)"
username="$(id -un)"
service_file_path="/etc/systemd/system/$service_name.service"
action="${1:-dryrun}"

if [[ "$action" == install || "$action" == dryrun ]]; then
    python_path="$(get_python_path)"
    "$python_path" -c 'import sys; sys.exit(0 if sys.version_info >= (3, 12) else "Python 3.12 or newer is required")'
    script_path="$working_directory/main.py"
    exec_python="${python_path//\$/\$\$}"
    exec_script="${script_path//\$/\$\$}"
    service_content="[Unit]
Description=$service_description
After=network-online.target
Wants=network-online.target

[Service]
User=$username
ExecStart=$(unit_quote "$exec_python") $(unit_quote "$exec_script")
WorkingDirectory=$(unit_quote "$working_directory")
Restart=on-failure
RestartSec=5
UMask=0077

[Install]
WantedBy=multi-user.target"
fi

case "$action" in
    dryrun)
        printf '%s\n' "$service_content"
        printf '\nUsage: bash %s <install|uninstall>\n' "$0"
        ;;
    install)
        printf '%s\n' "$service_content" | sudo tee "$service_file_path" > /dev/null
        sudo systemctl daemon-reload
        sudo systemctl enable "$service_name"
        sudo systemctl restart "$service_name"
        printf "Service '%s' installed successfully.\n" "$service_name"
        ;;
    uninstall)
        sudo systemctl stop "$service_name"
        sudo systemctl disable "$service_name"
        sudo rm -- "$service_file_path"
        sudo systemctl daemon-reload
        printf "Service '%s' removed successfully.\n" "$service_name"
        ;;
    *)
        printf 'Unknown action: %s\n' "$action" >&2
        exit 1
        ;;
esac
